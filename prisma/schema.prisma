// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GenStatus {
  IDLE
  SUBMITTING
  IN_QUEUE
  IN_PROGRESS
  COMPLETED
  ERROR
}

model Project {
  id          String   @id @default(cuid())
  title       String   @default("Untitled Project")
  aspectRatio String   @default("9:16") // "9:16" | "16:9" | "1:1"
  scenes      Scene[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Scene {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int     @default(0) // position in the project

  // editor inputs
  script      String  @default("")
  visualGuide String  @default("")
  imageUrl    String? // fal.storage URL of the product image

  // generation config (drives the fal model + input)
  type          String  @default("UGC") // creative style, injected into the prompt
  language      String  @default("English (US)") // spoken language, injected into the prompt
  model         String  @default("fal-ai/minimax-video/image-to-video") // fal endpoint id
  sound         Boolean @default(true) // native audio toggle (models that support it)
  startImageUrl String? // start frame / start card (falls back to imageUrl)
  endImageUrl   String? // end frame / end card (models that support it)

  // fal.ai job state (this is what survives refresh)
  requestId String? // fal queue request id — used to resume polling
  status    GenStatus @default(IDLE)
  videoUrl  String? // populated on COMPLETED
  error     String? // populated on ERROR

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([requestId])
}
